{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Workflow",
  "version": "0.1.0",
  "identifier": "local.workflow.desktop",
  "build": { "frontendDist": "ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "label": "main", "title": "Workflow", "width": 1500, "height": 960, "minWidth": 900, "minHeight": 600, "backgroundColor": "#101216", "devtools": true }],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost; connect-src ipc: http://ipc.localhost; font-src 'self' data:; object-src 'none'; base-uri 'none'",
      "capabilities": [{ "identifier": "main-capability", "webviews": ["main"], "permissions": ["core:default", "dialog:default", "opener:default", "notification:default"] }]
    }
  },
  "bundle": { "active": false, "icon": ["icons/icon.ico", "icons/icon.png"] }
}
